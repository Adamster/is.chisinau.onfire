NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Comma-separated extra hosts allowed to serve incident photos, for
# photos not stored on the Supabase project host. The Supabase host is always
# allowed. Mirrored into images.remotePatterns and the CSP img-src directive.
NEXT_PUBLIC_EXTRA_IMAGE_HOSTS=
